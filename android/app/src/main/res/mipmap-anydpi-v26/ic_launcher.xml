<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). The background is the solid black of
     the artwork, the foreground is resources/whereq-dosbox-1.png scaled into
     the 72dp safe zone so no mask shape can clip it. -->
