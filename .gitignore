# out-of-tree native/autotools build
/build/

# benchmark scratch dirs
/bench/run/
/bench/rt/

# Android build outputs
/android/.cxx/
/android/build/
/android/app/build/
/android/local.properties
/android/.gradle/

# Signing material - never commit these
/android/keystore.properties
*.keystore
*.jks

# third-party sources: fetched by third_party/fetch-sdl2.sh, not committed
/third_party/SDL2-*/
/third_party/*.tar.gz

# Native libraries staged for the Gradle build by android/build-android.sh.
# They are build output, not source - regenerate them with that script.
/android/app/src/main/jniLibs/
