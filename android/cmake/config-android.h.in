/*
 * config-android.h - Android/bionic configuration for DOSBox.
 *
 * Generated by CMake from cmake/config-android.h.in.
 * This file plays the same role as the autoconf-generated config.h of the
 * native build. include/dosbox.h includes it from *every* translation unit,
 * so it must provide the base integer types and the compiler attribute
 * macros as well as the feature switches.
 *
 * Feature set is intentionally the Android-equivalent one (see
 * porting/ANDROID-PORT.md):
 *   - C_SDLGFX      : SDL2 graphics back end
 *   - no C_OPENGL   : DOSBox's own fixed-function GL path is desktop GL and
 *                     cannot run on GLES2; we use the SDL_Renderer path
 *   - no C_DEBUG    : internal debugger needs curses
 *   - no C_CURSOUT  : no ncursesw on Android
 *   - C_DYNREC     : portable recompiling (JIT) core; the aarch64/armv7/x64
 *                     back ends in src/cpu/core_dynrec/ (no plugin needed)
 *   - no C_DYNAMIC_X86 : the x86-only dynamic core (C_DYNREC is used instead)
 *   - no C_DIRECTSERIAL : Android has no usable RS-232
 *   - no LINUX      : keeps the host serial/port bits out of the build
 */

#ifndef DOSBOX_CONFIG_ANDROID_H
#define DOSBOX_CONFIG_ANDROID_H

/* ---------------------------------------------------------------- package */
#define PACKAGE "whereq-dosbox"
#define PACKAGE_NAME "WhereQ-DOSBox"
#define PACKAGE_TARNAME "whereq-dosbox"
#define PACKAGE_VERSION "1.0.0.1"
#define PACKAGE_STRING "WhereQ-DOSBox 1.0.0.1"
#define PACKAGE_BUGREPORT ""
#define PACKAGE_URL ""
#define VERSION "1.0.0.1"

/* -------------------------------------------------------------- platform */
#define STDC_HEADERS 1

#define SIZEOF_UNSIGNED_CHAR 1
#define SIZEOF_UNSIGNED_SHORT 2
#define SIZEOF_UNSIGNED_INT 4
/* These two must match the target ABI: "long" is 8 bytes on arm64-v8a and
   x86_64, but only 4 bytes on armeabi-v7a and x86 (ILP32). DOSBox picks its
   Bit64u/Bit64s typedefs from them, so a wrong value silently truncates the
   64 bit x86 arithmetic (MUL/DIV/IMUL/IDIV, RDTSC) on 32 bit targets. */
#define SIZEOF_UNSIGNED_LONG @DOSBOX_SIZEOF_UNSIGNED_LONG@
#define SIZEOF_UNSIGNED_LONG_LONG @DOSBOX_SIZEOF_UNSIGNED_LONG_LONG@
#define SIZEOF_INT_P @DOSBOX_SIZEOF_INT_P@

/* bionic has all of these */
#define HAVE_INTTYPES_H 1
#define HAVE_NETINET_IN_H 1
#define HAVE_REALPATH 1
#define HAVE_STDINT_H 1
#define HAVE_STDIO_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRINGS_H 1
#define HAVE_STRING_H 1
#define HAVE_SYS_SOCKET_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_UNISTD_H 1

/* NOT defined: HAVE_PWD_H
 * bionic ships <pwd.h> but getpwnam() is a stub that always returns NULL;
 * src/misc/cross.cpp would then take a broken home-directory path.
 */
/* NOT defined: LINUX
 * src/hardware/serialport/libserial.cpp keys its termios/ioctl code off
 * LINUX/MACOSX/BSD; leaving it undefined keeps that out of the build.
 */
#define DIRENT_HAS_D_TYPE 1
#define ENVIRON_LINKED 1
#define DB_HAVE_CLOCK_GETTIME 1
#define C_SET_PRIORITY 1
#define C_HAVE_MPROTECT 1

/* ----------------------------------------------------------- compiler */
#define C_ATTRIBUTE_ALWAYS_INLINE 1
#define C_ATTRIBUTE_FASTCALL 0
#define C_HAS_ATTRIBUTE 1
#define C_HAS_BUILTIN_EXPECT 1

#if C_ATTRIBUTE_ALWAYS_INLINE
#define INLINE inline __attribute__((always_inline))
#else
#define INLINE inline
#endif

#if C_ATTRIBUTE_FASTCALL
#define DB_FASTCALL __attribute__((fastcall))
#else
#define DB_FASTCALL
#endif

#if C_HAS_ATTRIBUTE
#define GCC_ATTRIBUTE(x) __attribute__ ((x))
#else
#define GCC_ATTRIBUTE(x) /* attribute not supported */
#endif

#if C_HAS_BUILTIN_EXPECT
#define GCC_UNLIKELY(x) __builtin_expect((x),0)
#define GCC_LIKELY(x) __builtin_expect((x),1)
#else
#define GCC_UNLIKELY(x) (x)
#define GCC_LIKELY(x) (x)
#endif

/* ------------------------------------------------------------- features */
#define C_SDLGFX 1
#define C_FPU 1
/* C_FPU_X86 selects src/fpu/fpu_instructions_x86.h, which contains 28 x86
 * inline-asm blocks ("fldl", "ax", ...) and therefore only compiles on x86.
 * On ARM we must use the portable implementation in fpu_instructions.h.
 * This is the same choice the upstream Visual C config.h makes for non-x86. */
#define C_FPU_X86 0
#define C_CORE_INLINE 1
#define C_UNALIGNED_MEMORY 1
#define C_TARGETCPU @DOSBOX_C_TARGETCPU@

/* C_DYNREC: the portable recompiling CPU core (a JIT). The per-architecture
 * code generators live in src/cpu/core_dynrec/ — risc_armv8le.h (arm64-v8a),
 * risc_armv4le.h (armeabi-v7a) and risc_x64.h (x86_64, emulator). There is no
 * GCC plugin involved; the generators emit machine code into a cache buffer at
 * run time and flush the I-cache with __builtin___clear_cache (a clang
 * builtin). The buffer is made executable with an anonymous PROT_EXEC mmap on
 * Android (see the __ANDROID__ branch in src/cpu/core_dynrec/cache.h), because
 * Android forbids making malloc'd heap executable (W^X).
 *
 * The executable cache is only allocated when core=dynamic/auto is selected
 * (CPU_Core_Dynrec_Cache_Init(enable) in src/cpu/cpu.cpp). The shipped
 * core=auto allocates it at the first switch into protected mode, so a
 * real-mode-only program never pays for it and never touches the RWX
 * mapping; core=normal remains the fallback if the mmap fails. */
#define C_DYNREC 1

/* Deliberately NOT defined:
 *   C_DEBUG, C_CURSOUT, C_OPENGL, C_DYNAMIC_X86,
 *   C_DIRECTSERIAL, C_MODEM, C_IPX
 */

/* ---------------------------------------------------------- base types */
typedef double Real64;

typedef unsigned char  Bit8u;
typedef signed char    Bit8s;
typedef unsigned short Bit16u;
typedef signed short   Bit16s;

#if SIZEOF_UNSIGNED_INT == 4
typedef unsigned int Bit32u;
typedef signed int   Bit32s;
#define sBit32t
#elif SIZEOF_UNSIGNED_LONG == 4
typedef unsigned long Bit32u;
typedef signed long   Bit32s;
#define sBit32t "l"
#else
#error "can't find sizeof(type) of 4 bytes!"
#endif
#define sBit32fs(a) sBit32t #a

#if SIZEOF_UNSIGNED_LONG == 8
typedef unsigned long Bit64u;
typedef signed long   Bit64s;
#define sBit64t "l"
#elif SIZEOF_UNSIGNED_LONG_LONG == 8
typedef unsigned long long Bit64u;
typedef signed long long   Bit64s;
#define sBit64t "ll"
#else
#error "can't find data type of 8 bytes"
#endif
#define sBit64fs(a) sBit64t #a

#if SIZEOF_INT_P == 4
typedef Bit32u Bitu;
typedef Bit32s Bits;
#define sBitfs sBit32fs
#else
typedef Bit64u Bitu;
typedef Bit64s Bits;
#define sBitfs sBit64fs
#endif

#endif /* DOSBOX_CONFIG_ANDROID_H */
