<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). The background is the navy of the
     WhereQ logo, the foreground is the ">_" mark scaled into the 72dp safe
     zone so no mask shape can clip it. Both are generated from the logo in
     resources/ by android/make-icons.py - do not edit them by hand. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
