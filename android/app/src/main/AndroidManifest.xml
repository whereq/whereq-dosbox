<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.whereq.dosbox"
    android:versionCode="1000002"
    android:versionName="1.0.0.2"
    android:installLocation="auto">

    <!-- SDL2's video back end needs OpenGL ES 2.0 -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Touchscreen is how a phone user drives DOSBox -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Game controllers / bluetooth peripherals are optional -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true">
        <!-- android:debuggable is NOT set here: the debug build gets it from
             aapt2's debug mode flag, the release build must not be
             debuggable. -->

        <activity
            android:name="com.whereq.dosbox.WhereqDosboxActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleTop"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">

            <!-- singleTop, not singleInstance: the game launcher opens the
                 system file picker with startActivityForResult(), and a
                 singleInstance activity lives in a task of its own, which
                 keeps the picker's result from coming back. With a single
                 activity in the app, singleTop gives the same "only one
                 instance" behaviour without that problem. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A game bundle can also be opened straight from a file
                 manager: pick a .zip and choose WhereQ-DOSBox. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>

            <!-- Let Android know that we can handle some USB devices -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>
</manifest>
